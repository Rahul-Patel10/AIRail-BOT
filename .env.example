# Groq LLM (required for full agent behavior)
GROQ_API_KEY=
GROQ_MODEL=llama-3.1-8b-instant

# ChromaDB storage path
CHROMA_PERSIST_DIRECTORY=backend/chroma_store

# RailRadar API (optional — SQLite fallback when unset or on failure)
RAILRADAR_BASE_URL=https://api.railradar.in/v1
RAILRADAR_API_KEY=
RAILRADAR_TIMEOUT=15
RAILRADAR_RATE_LIMIT=10

# Generic live train API (optional secondary fallback)
LIVE_TRAIN_API_BASE_URL=
LIVE_TRAIN_API_KEY=
LIVE_TRAIN_API_TIMEOUT=15
